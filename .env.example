# Opcional e pago à parte: com uma chave da API da Anthropic, PDFs e fotos são lidos pelo Claude.
# Sem ela, a leitura é gratuita (PDF do banco, CSV ou OFX).
ANTHROPIC_API_KEY=

# Recomendado: senha pedida pelo navegador ao abrir o app (qualquer usuário serve).
# Sem ela, qualquer pessoa conectada à sua Wi-Fi consegue abrir os gastos.
APP_PASSWORD=

# Opcional: modelo e esforço usados na leitura das faturas
# (claude-sonnet-5-5 custa cerca de metade do claude-opus-5-5)
# EXTRACTION_MODEL=claude-opus-5-5
# EXTRACTION_EFFORT=medium

# Opcional: porta do servidor
# PORT=8000

# Opcional: Open Finance pelo Meu Pluggy (dá para configurar pela tela do app, em Importar).
# PLUGGY_CLIENT_ID=
# PLUGGY_CLIENT_SECRET=
# PLUGGY_ITEM_IDS=   # um ou mais, separados por vírgula
