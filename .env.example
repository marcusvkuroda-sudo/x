# Chave da API da Anthropic (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=

# Opcional: senha pedida pelo navegador ao abrir o app (qualquer usuário serve)
APP_PASSWORD=

# Opcional: modelo e esforço usados na leitura das faturas
# EXTRACTION_MODEL=claude-opus-5-5
# EXTRACTION_EFFORT=medium

# Opcional: porta do servidor
# PORT=8000
