# Chave da API da Anthropic (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=

# Recomendado: senha pedida pelo navegador ao abrir o app (qualquer usuário serve).
# Sem ela, qualquer pessoa conectada à sua Wi-Fi consegue abrir os gastos.
APP_PASSWORD=

# Opcional: modelo e esforço usados na leitura das faturas
# (claude-sonnet-5-5 custa cerca de metade do claude-opus-5-5)
# EXTRACTION_MODEL=claude-opus-5-5
# EXTRACTION_EFFORT=medium

# Opcional: porta do servidor
# PORT=8000
